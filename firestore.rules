rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
    match /couples/{coupleId} {
      allow read, write: if signedIn();
      match /locations/{uid} {
        allow read, write: if signedIn();
      }
    }
  }
}
